<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme"
        android:localeConfig="@xml/locales_config">
        <!-- usesCleartextTraffic: a Pi on the home network answers over plain HTTP (app/src/remote.ts) -->
        <!-- localeConfig: the app's language can be chosen in Android's settings (13 and later), like
             any app's. No "locale" in configChanges below: choosing one restarts the app, and the
             page comes back in the new language. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- "Use my location" for the weather; the app keeps it to two decimals (about a kilometre).
         Approximate only (app/src/native.ts): no ACCESS_FINE_LOCATION, so the dialog never offers
         or asks again for the precise one. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- The short buzz with the pet's answers (app/src/haptics.ts); granted at install, no dialog -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The pet calls when it needs somebody (app/src/notify.ts); asked for after its first meal -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A few minutes late is fine: no exact alarms (the notification plugin would ask for them) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
</manifest>
